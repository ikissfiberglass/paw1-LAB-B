{% extends 'base.html.twig' %}

{% block title %}Edit forecast measurement{% endblock %}

{% block body %}
    <h1>Edit forecast measurement for {{ location.city }}</h1>

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button class="btn">Save</button>
    {{ form_end(form) }}

    <a href="{{ path('app_weather', {'city': location.city}) }}">Back to measurements</a>
{% endblock %}
