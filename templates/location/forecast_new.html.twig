{% extends 'base.html.twig' %}

{% block title %}New forecast measurement{% endblock %}

{% block body %}
    <h1>Create forecast measurement for {{ location.city }}</h1>

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button class="btn">Save</button>
    {{ form_end(form) }}

    <a href="{{ path('app_location_edit', {'id': location.id}) }}">Back to location</a>
{% endblock %}
