{% extends 'base.html.twig' %}

{# @var location \App\Entity\Location #}
{# @var weather \App\Entity\Weather #}


{% block title %}Weather in {{ location.city }}, {{ location.country}}  {% endblock %}

{% block body %}
    <main>
        <h1>Weather in {{ location.city }}, {{ location.country }}</h1>

        <ul>
            {% for measurement in measurements %}
                <li>{{ measurement.timestamp|date('d.m.Y H:i') }}: {{ measurement.temperatureC }}&deg;C,
                    wilgotność: {{ measurement.humidity }}%,  ciśnienie: {{ measurement.athmosphericPressure }}hPa,
                    prędkość wiatru: {{ measurement.windSpeed }}km/h,
                    opady w najbliższe 6h: {% if measurement.anyPrecipitationsForTheNearest6Hours%} Tak {% else %} Nie {% endif %}


                </li>
            {% endfor %}
        </ul>
    </main>

{% endblock %}
