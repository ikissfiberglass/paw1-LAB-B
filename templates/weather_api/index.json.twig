{
    "city": "{{ city }}",
    "country": "{{ country }}",
    "measurements": [
        {% for m in measurements %}
        {
            "date": "{{ m.timestamp|date('Y-m-d') }}",
            "celsius": "{{ m.temperatureC }}",
            "fahrenheit": "{{ m.fahrenheit }}"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
